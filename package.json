{
  "name": "mp3-scrambler",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "clearmods": "rm -rf node_modules && rm -rf client/node_modules",
    "rsync-go": "rsync . -avz john@38.108.119.159:~/mp3-scrambler",
    "send": "yarn clearmods && yarn rsync-go",
    "build": "cd client && yarn && yarn build",
    "dev": "yarn && cd server && nodemon .",
    "start": "cd server && pm2 start index.js --name \"mp3-scrambler\"",
    "postinstall": "cd client && yarn"
  },
  "dependencies": {
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "express-fileupload": "^1.2.0",
    "ffmetadata": "^1.6.0",
    "fluent-ffmpeg": "^2.1.2",
    "youtube-dl": "^3.0.2"
  }
}
